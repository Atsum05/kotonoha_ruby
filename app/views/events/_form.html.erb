<%= form_with model: event, local: true, class: "event-form" do |f| %>
  <% if event.errors.any? %>
    <div class="form-errors">
      <p><strong><%= pluralize(event.errors.count, "error") %> impidieron guardar este evento:</strong></p>
      <ul>
        <% event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title, "Título" %>
    <%= f.text_field :title %>
  </div>

  <div class="field">
    <%= f.label :description, "Descripción" %>
    <%= f.text_area :description, rows: 4 %>
  </div>

  <div class="field">
    <%= f.label :event_date, "Fecha y hora" %>
    <%= f.datetime_field :event_date %>
  </div>

  <div class="field">
    <%= f.label :location, "Lugar" %>
    <%= f.text_field :location %>
  </div>

  <div class="field">
    <%= f.label :capacity, "Cupos (déjalo en blanco para cupos ilimitados)" %>
    <%= f.number_field :capacity, min: 1 %>
  </div>

  <div class="field">
    <%= f.label :form_url, "Link de inscripción (formulario)" %>
    <%= f.url_field :form_url, placeholder: "https://forms.gle/..." %>
  </div>

  <div class="field">
    <%= f.label :status, "Estado" %>
    <%= f.select :status, Event.statuses.keys.map { |s| [s.capitalize, s] } %>
  </div>

  <div class="field">
    <%= f.label :image, "Imagen del evento" %>
    <% if event.image.attached? %>
      <div class="current-image">
        <%= image_tag event.image, class: "event-image-preview" %>
      </div>
    <% end %>
    <%= f.file_field :image, accept: "image/png,image/jpeg,image/webp" %>
  </div>

  <div class="field">
    <%= f.submit event.new_record? ? "Crear evento" : "Guardar cambios", class: "btn-primary" %>
  </div>
<% end %>
